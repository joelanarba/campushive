# Server Configuration
# Note: On Windows, port 5000 is frequently reserved by the OS. Use PORT=5001 if you encounter EACCES errors.
PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:Password133-@localhost:5432/CampusHive"

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Required: generate a random secret (at least 32 bytes). No default is used.
JWT_ACCESS_SECRET=
# Authentication: lifetimes are positive integer seconds.
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=campushive-api
JWT_AUDIENCE=campushive-client
REFRESH_TOKEN_TTL_SECONDS=604800
# lax for same-site; none requires HTTPS, exact CLIENT_URL origins and CSRF header.
AUTH_COOKIE_SAME_SITE=lax
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# CLIENT_URL accepts comma-separated exact origins; never use * with credentials.
