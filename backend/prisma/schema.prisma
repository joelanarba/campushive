generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  entrepreneur
  admin
}

enum VerificationStatus {
  pending
  verified
  rejected
  suspended

  @@map("verification_status")
}

enum LocationType {
  online
  provider_location
  customer_location

  @@map("location_type_values")
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed

  @@map("status_value")
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  full_name         String
  email             String   @unique
  role              Role[]   @default([student])
  is_email_verified Boolean  @default(false)
  password_hash     String
  created_at        DateTime @default(now()) @db.Timestamptz(3)

  entrepreneur_profiles EntrepreneurProfile[]
  bookings              Booking[]
  refresh_tokens        RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  token_hash  String    @unique @db.VarChar(64)
  family_id   String    @db.Uuid
  expires_at  DateTime  @db.Timestamptz(3)
  revoked_at  DateTime? @db.Timestamptz(3)
  consumed_at DateTime? @db.Timestamptz(3)
  created_at  DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
  @@index([expires_at])
  @@map("refresh_tokens")
}

model EntrepreneurProfile {
  id                  String             @id @default(uuid()) @db.Uuid
  user_id             String             @db.Uuid
  business_name       String
  description         String
  phone_number        String
  location            String
  verification_status VerificationStatus @default(pending)
  rejection_reason    String?
  created_at          DateTime           @default(now()) @db.Timestamptz(3)

  user     User      @relation(fields: [user_id], references: [id], onDelete: Restrict)
  services Service[]

  @@index([user_id])
  @@map("entrepreneur_profiles")
}

model Service {
  id               String       @id @default(uuid()) @db.Uuid
  title            String
  description      String
  entrepreneur_id  String       @db.Uuid
  category_id      String       @db.Uuid
  is_active        Boolean      @default(true)
  location_type    LocationType
  price            Decimal      @db.Decimal(12, 2)
  duration_minutes Int
  created_at       DateTime     @default(now()) @db.Timestamptz(3)
  updated_at       DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  entrepreneur       EntrepreneurProfile @relation(fields: [entrepreneur_id], references: [id], onDelete: Restrict)
  category           ServiceCategory     @relation(fields: [category_id], references: [id], onDelete: Restrict)
  availability_slots AvailabilitySlot[]
  bookings           Booking[]

  @@index([entrepreneur_id])
  @@index([category_id])
  @@map("services")
}

model ServiceCategory {
  id            String   @id @default(uuid()) @db.Uuid
  category_name String
  tag           String
  description   String
  created_at    DateTime @default(now()) @db.Timestamptz(3)

  services Service[]

  @@map("services_category")
}

model AvailabilitySlot {
  id         String   @id @default(uuid()) @db.Uuid
  service_id String   @db.Uuid
  slot_date  DateTime? @db.Date
  weekday    Int?
  is_active  Boolean  @default(true)
  version    Int      @default(1)
  start_time DateTime @db.Time(0)
  end_time   DateTime @db.Time(0)
  is_booked  Boolean  @default(false)

  service  Service   @relation(fields: [service_id], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@index([service_id, slot_date])
  @@index([service_id, weekday, is_active])
  @@map("availability_slots")
}

model Booking {
  id                    String        @id @default(uuid()) @db.Uuid
  service_id            String        @db.Uuid
  slot_id               String        @db.Uuid
  user_id               String        @db.Uuid
  booking_reference     String        @unique
  status                BookingStatus @default(pending)
  created_at            DateTime      @default(now()) @db.Timestamptz(3)
  service_name_snapshot String        @db.VarChar(255)
  starts_at             DateTime      @db.Timestamptz(3)
  ends_at               DateTime      @db.Timestamptz(3)

  service Service          @relation(fields: [service_id], references: [id], onDelete: Restrict)
  slot    AvailabilitySlot @relation(fields: [slot_id], references: [id], onDelete: Restrict)
  user    User             @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([service_id])
  @@index([slot_id])
  @@index([service_id, status, starts_at, ends_at])
  @@index([slot_id, status, ends_at])
  @@index([user_id])
  @@map("bookings")
}
